{
  "manifest_version": 3,
  "name": "回过了 · X 通知助手",
  "version": "0.13.0",
  "minimum_chrome_version": "111",
  "description": "识别 X 原帖与互动记录，可分别筛选主页及通知中的已完成互动，支持手动点赞和连续回复。每条由你确认，统计仅保存在本机。",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "回过了 · X 通知助手", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["core.js", "observe.js"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "run_at": "document_start",
      "js": ["card-filter.js", "home-filter.js", "like-notifications.js", "notification-filter.js", "continuous.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
