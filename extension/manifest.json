{
  "manifest_version": 3,
  "name": "回过了 · X 通知助手",
  "version": "0.16.5",
  "minimum_chrome_version": "111",
  "description": "识别 X 原帖与互动记录，可分别筛选主页及通知中的已完成互动，支持手动点赞和连续回复。每条由你确认，统计仅保存在本机。",
  "permissions": ["storage", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "options_page": "ai-settings.html",
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "回过了 · X 通知助手", "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" } },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["core.js", "follow-context.js", "notification-network.js", "observe.js"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "run_at": "document_start",
      "js": ["follow-context.js", "card-filter.js", "home-filter.js", "notification-filter.js", "editor.js", "ai-replies.js", "continuous.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
